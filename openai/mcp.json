{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "aci-risk-indicators": {
      "type": "streamable-http",
      "url": "https://mcp.aethoncredit.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://aethoncredit.com/api/oauth/authorize",
            "tokenUrl": "https://aethoncredit.com/api/oauth/token",
            "registrationUrl": "https://aethoncredit.com/api/oauth/register"
          }
        }
      }
    }
  }
}
